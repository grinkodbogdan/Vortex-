#!/bin/sh
# Audio on the Nokia 6300 4G: QDSP6 in the modem firmware plus the codecs in
# the SoC and PM8909 (see tools/phone/dts/qcom-msm8909-nokia-leo-vortex.dts).
#
#   vortex-audio setup      load the drivers, set the mixer whenever the
#                           card (re)appears (modem start/restart), and send
#                           sound to Bluetooth headphones while one is
#                           connected; the "audio" service runs this
#   vortex-audio mixer      set the mixer once
#   vortex-audio output     print where sound goes: phone or bt
#   vortex-audio call on|off|speaker|earpiece
#                           route a voice call (the modem DSP's CS-Voice
#                           session) to the earpiece or the speaker
#   vortex-audio volume [up|down|get|N]
#                           media volume, 0-15 (3 dB steps), remembered in
#                           /var/lib/vortex/volume; prints the new level
#
# The modem (and with it the sound card) can come up minutes after boot,
# when udevd is no longer running to load modules, so load them here.
set -u
CARD=${VORTEX_AUDIO_CARD:-msm8909}
MODULES="apr q6core q6afe q6afe-dai q6afe-clocks q6asm q6asm-dai q6adm q6routing
	q6voice-common q6mvm q6cvs q6cvp q6voice-dai
	snd-soc-msm8916-digital snd-soc-msm8916-analog snd-soc-apq8016-sbc"

log() { echo "vortex-audio: $*"; }

VOLUME_FILE=/var/lib/vortex/volume

volume() { # [up|down|get|N]
	v=$(cat "$VOLUME_FILE" 2>/dev/null) || v=12
	case $v in '' | *[!0-9]*) v=12 ;; esac
	case ${1:-get} in
	up) v=$((v + 1)) ;;
	down) v=$((v - 1)) ;;
	get) ;;
	*[!0-9]* | '') echo "usage: vortex-audio volume [up|down|get|N]" >&2; return 2 ;;
	*) v=$1 ;;
	esac
	[ "$v" -gt 15 ] && v=15
	[ "$v" -lt 0 ] && v=0
	[ "${1:-get}" = get ] || echo "$v" > "$VOLUME_FILE" 2>/dev/null
	# 15 = 0 dB, each step 3 dB down, 0 = silent
	if [ "$v" -eq 0 ]; then db=-84; else db=$(((v - 15) * 3)); fi
	for r in RX1 RX2 RX3; do
		amixer -q -c "$CARD" sset "$r Digital" "${db}dB" 2>/dev/null
	done
	echo "$v"
}

# A connected Bluetooth device that receives audio (A2DP sink)?
bt_audio_connected() {
	sv status bluetoothd 2>/dev/null | grep -q '^run:' || return 1
	for m in $(bluetoothctl devices Connected </dev/null 2>/dev/null | awk '$1 == "Device" {print $2}'); do
		bluetoothctl info "$m" </dev/null 2>/dev/null | grep -q 'UUID: Audio Sink' && return 0
	done
	return 1
}

# Point ALSA's default at the headphones or the phone.  Programs read
# /etc/asound.conf each time they open a sound device.
route_output() {
	want=phone
	bt_audio_connected && want=bt
	src=/usr/share/vortex/asound-$want.conf
	if ! cmp -s "$src" /etc/asound.conf; then
		cp "$src" /etc/asound.conf.new && mv /etc/asound.conf.new /etc/asound.conf
		log "sound output: $want"
	fi
}

c() { # control value: set it, say so if the control is missing
	amixer -q -c "$CARD" cset "name=$1" "$2" 2>/dev/null || log "mixer: cannot set '$1' to $2"
}

mixer() {
	# DSP routing: media stream 1 and 3 to the codec, codec mic to stream 2
	c 'PRI_MI2S_RX Audio Mixer MultiMedia1' 1
	c 'PRI_MI2S_RX Audio Mixer MultiMedia3' 1
	c 'MultiMedia2 Mixer TERT_MI2S_TX' 1
	# speaker (RX3) and headphones (RX1/RX2), as ALSA's msm8916 profile
	c 'RX1 MIX1 INP1' RX1
	c 'RX2 MIX1 INP1' RX2
	c 'RX3 MIX1 INP1' RX1
	c 'RDAC2 MUX' RX2
	c 'SPK DAC Switch' 1
	c 'HPHL' 1
	c 'HPHR' 1
	log "volume $(volume get)"
	# main microphone
	c 'DEC1 MUX' ADC1
	c 'CIC1 MUX' AMIC
	c 'ADC1 Volume' 8
	log "mixer set"
}

case ${1:-} in
setup)
	for m in $MODULES; do
		modprobe -q "$m" || log "cannot load $m"
	done
	up=0 waited=0
	while :; do
		if [ -e "/proc/asound/$CARD" ]; then
			if [ $up = 0 ]; then
				log "sound card up: $(cat "/proc/asound/$CARD/id" 2>/dev/null)"
				mixer
				up=1
			fi
		else
			[ $up = 1 ] && log "sound card gone (modem restart?)"
			up=0
			waited=$((waited + 1))
			[ $waited -eq 20 ] && log "waiting for the sound card (it appears once the modem runs)"
		fi
		route_output
		# Bluetooth headphones are only looked for while Bluetooth is on;
		# otherwise wake rarely (every wake-up costs battery)
		if [ $up = 0 ]; then
			sleep 3
		elif sv status bluetoothd 2>/dev/null | grep -q '^run:'; then
			sleep 5
		else
			sleep 30
		fi
	done
	;;
volume)
	volume "${2:-get}"
	;;
call)
	case ${2:-} in
	on | earpiece)
		c 'PRI_MI2S_RX Voice Mixer CS-Voice' 1
		c 'CS-Voice Capture Mixer TERT_MI2S_TX' 1
		c 'SPK DAC Switch' 0
		c 'EAR_S' Switch
		;;
	speaker)
		c 'EAR_S' ZERO
		c 'SPK DAC Switch' 1
		;;
	off)
		c 'PRI_MI2S_RX Voice Mixer CS-Voice' 0
		c 'CS-Voice Capture Mixer TERT_MI2S_TX' 0
		c 'EAR_S' ZERO
		c 'SPK DAC Switch' 1
		;;
	*) echo "usage: vortex-audio call on|off|speaker|earpiece" >&2; exit 2 ;;
	esac
	;;
output)
	if grep -q vortex_bt /etc/asound.conf 2>/dev/null; then echo bt; else echo phone; fi
	;;
mixer)
	mixer
	;;
*)
	echo "usage: vortex-audio setup|mixer|output|volume [up|down|get|N]|call on|off|speaker|earpiece" >&2
	exit 2
	;;
esac
