#!/bin/sh
# The shell's way to the modem.  vortex-modem talks to ModemManager as
# root; the shell (user "vortex") goes through doas.
#
#   vortex-call dial NUMBER | answer | hangup | speaker on|off
#   vortex-call sms NUMBER TEXT
set -eu
M=/usr/libexec/vortex/vortex-modem
[ "${1:-}" = sms ] && { shift; set -- sms-send "$@"; }
if [ "$(id -u)" = 0 ]; then exec "$M" "$@"; fi
exec doas "$M" "$@"
