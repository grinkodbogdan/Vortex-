From: Vortex
Subject: [PATCH] ASoC: qcom: apq8016_sbc: start MI2S bit clocks with CLOCK_SET too

The MSM8909 modem's QDSP6 firmware accepts AFE_PARAM_ID_LPAIF_CLK_CONFIG
(LPAIF_BIT_CLK) but does not start the clock: a stream then runs while the
DSP never takes a sample.  Qualcomm's msm8952 machine driver uses
AFE_PARAM_ID_CLOCK_SET with the port's IBIT clock instead (mi2s_rx_clk,
mi2s_tx_clk: 1.536 MHz).  Request that as well; firmware without it (older
MSM8916) just refuses, which is harmless.

--- a/sound/soc/qcom/apq8016_sbc.c
+++ b/sound/soc/qcom/apq8016_sbc.c
@@ -190,6 +190,15 @@
 	return apq8016_dai_init(rtd, qdsp6_dai_get_lpass_id(cpu_dai));
 }
 
+/* The port's own bit clock for AFE CLOCK_SET (PRI, SEC, TER, QUAD). */
+static void msm8916_qdsp6_ibit(struct snd_soc_dai *cpu_dai, int mi2s, unsigned int rate)
+{
+	int ret = snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT + 2 * mi2s,
+					 rate, 0);
+	if (ret)
+		dev_dbg(cpu_dai->dev, "CLOCK_SET for MI2S %d: %d\n", mi2s, ret);
+}
+
 static int msm8916_qdsp6_startup(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = substream->private_data;
@@ -208,6 +217,7 @@
 	ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_BIT_CLK, MI2S_BCLK_RATE, 0);
 	if (ret)
 		dev_err(card->dev, "Failed to enable LPAIF bit clk: %d\n", ret);
+	msm8916_qdsp6_ibit(cpu_dai, mi2s, MI2S_BCLK_RATE);
 	return ret;
 }
 
@@ -229,6 +239,7 @@
 	ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_BIT_CLK, 0, 0);
 	if (ret)
 		dev_err(card->dev, "Failed to disable LPAIF bit clk: %d\n", ret);
+	msm8916_qdsp6_ibit(cpu_dai, mi2s, 0);
 }
 
 static const struct snd_soc_ops msm8916_qdsp6_be_ops = {
