#!/bin/sh
# Root shell on the USB serial console (debug builds).  On the PC:
#   screen /dev/ttyACM0 115200
# The initramfs normally sets the gadget up already; create it if not.
exec 2>&1
if [ ! -e /dev/ttyGS0 ]; then
	g=$(/usr/libexec/vortex/vortex-usb-gadget) || exit 1
	# adbd binds the gadget once its function is ready; without adbd, bind here
	[ -e /etc/runit/runsvdir/default/adbd ] || ls /sys/class/udc > "$g/UDC"
	sleep 1
fi
exec agetty --autologin root --noclear --local-line ttyGS0 115200 vt100
