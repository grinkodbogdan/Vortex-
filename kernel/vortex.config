# Vortex kernel config fragment, merged on top of postmarketOS'
# config-postmarketos-qcom-msm8916.armv7 (see kernel/build.sh).
#
# Goal: boot without an initramfs, keep kernel memory small, and provide
# what the userspace RAM budget relies on (zram, fbdev for the shell).

# Root on SD card / eMMC without an initramfs
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Shell display: DRM fbdev emulation on top of panel-mipi-dbi
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_DRM_PANEL_MIPI_DBI=m
CONFIG_FRAMEBUFFER_CONSOLE=n
# No virtual terminals: nothing draws over the UI, ~100 KB saved
CONFIG_VT=n

# Keypad
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_MATRIX=y

# Memory: compressed swap in RAM
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_PSI=y

# Trim: debugging and features a feature phone does not use
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_FTRACE=n
CONFIG_KALLSYMS_ALL=n
CONFIG_IKCONFIG=n
CONFIG_AUDIT=n
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_SECURITY_SELINUX=n
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_SOUND_OSS_CORE=n
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
